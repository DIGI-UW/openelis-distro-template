# Local environment for this OpenELIS distro.
#
# Secrets below are generated by a Copier post-generate task at
# `copier copy --trust` time, unique per distro. If you see literal
# `__GENERATED_SECRET__` values, the task didn't run (declined trust
# prompt, or `--trust` was missing) — re-run with `copier copy --trust`
# or manually replace each sentinel with `python3 -c 'import secrets;
# print(secrets.token_urlsafe(32))'`. To rotate later, replace the value
# and restart the affected service (e.g. `docker compose restart
# db.openelis.org` after POSTGRES_PASSWORD). For production, source
# secrets from your secret store rather than distributing this file.

COMPOSE_PROJECT_NAME=openelis-{{ context_slug }}
POSTGRES_PASSWORD=__GENERATED_SECRET__
FHIRSTORE_PASSWORD=__GENERATED_SECRET__
OPENELIS_HTTP_PORT=8080
OPENELIS_PROXY_PORT=80
TZ={{ timezone }}
PUBLIC_HOSTNAME={{ public_hostname }}
