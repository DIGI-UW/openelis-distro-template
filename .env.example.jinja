# Local environment for this OpenELIS distro.
#
# Secrets below are generated at `copier copy` time, unique per distro.
# To rotate, replace the value and restart the affected service
# (e.g. `docker compose restart db.openelis.org` after POSTGRES_PASSWORD).
# For production, source secrets from your secret store rather than
# distributing this file.

COMPOSE_PROJECT_NAME=openelis-{{ context_slug }}
POSTGRES_PASSWORD=__GENERATED_SECRET__
OPENELIS_HTTP_PORT=8080
OPENELIS_PROXY_PORT=80
TZ={{ timezone }}
PUBLIC_HOSTNAME={{ public_hostname }}
