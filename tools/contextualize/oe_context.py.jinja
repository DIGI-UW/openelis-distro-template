#!/usr/bin/env python3
from __future__ import annotations

import subprocess
from pathlib import Path
from typing import Any

import questionary
import typer
import yaml

app = typer.Typer(help="Contextualize this OpenELIS distro.")


def repo_root() -> Path:
    return Path(__file__).resolve().parents[2]


def load_yaml(path: Path) -> dict[str, Any]:
    with path.open("r", encoding="utf-8") as handle:
        data = yaml.safe_load(handle) or {}
    if not isinstance(data, dict):
        raise typer.BadParameter(f"{path} must contain a YAML mapping")
    return data


def surfaces() -> list[dict[str, Any]]:
    data = load_yaml(repo_root() / "context" / "config-surfaces.yml")
    return list(data.get("surfaces") or [])


def load_profile(profile: str) -> dict[str, Any]:
    return load_yaml(repo_root() / "context" / "profiles" / profile / "context.yml")


def _git(*args: str, cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        capture_output=True,
        text=True,
        check=False,
    )


def _is_git_repo(root: Path) -> bool:
    return _git("rev-parse", "--is-inside-work-tree", cwd=root).returncode == 0


def _check_env_safety(root: Path) -> list[str]:
    # `.env` is documented as a step in the quickstart (`cp .env.example .env`),
    # so its mere existence is fine. What's NOT fine is `.env` slipping into
    # version control: ignored-but-tracked, or simply not ignored at all.
    env_file = root / ".env"
    if not env_file.exists():
        return []
    if not _is_git_repo(root):
        return []
    failures: list[str] = []
    if _git("ls-files", "--error-unmatch", ".env", cwd=root).returncode == 0:
        failures.append(".env is tracked by git; remove from index and add to .gitignore")
    if _git("check-ignore", "-q", ".env", cwd=root).returncode != 0:
        failures.append(".env exists but is not matched by .gitignore")
    return failures


# Values that must never reach production for any of SECRET_VARS. Includes the
# upstream OE default ("adminADMIN!"), the PR #1 placeholders ("change-me",
# "demo-password"), the empty string, and the copier sentinel
# ("__GENERATED_SECRET__") that would mean the post-generate task never ran.
KNOWN_BAD_SECRETS = frozenset(
    {"change-me", "demo-password", "adminADMIN!", "", "__GENERATED_SECRET__"}
)
SECRET_VARS = ("POSTGRES_PASSWORD", "FHIRSTORE_PASSWORD")


def _parse_env(path: Path) -> dict[str, str]:
    if not path.exists():
        return {}
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, _, value = line.partition("=")
        values[key.strip()] = value.strip()
    return values


def _check_known_bad_secrets(
    root: Path, prod: bool
) -> tuple[list[str], list[str]]:
    failures: list[str] = []
    warnings: list[str] = []

    properties = root / "configs" / "properties" / "common.properties"
    if properties.exists() and "adminADMIN!" in properties.read_text(encoding="utf-8"):
        failures.append(
            "configs/properties/common.properties contains 'adminADMIN!'; "
            "use ${FHIRSTORE_PASSWORD} and rotate via .env"
        )

    env_values = _parse_env(root / ".env")
    example_values = _parse_env(root / ".env.example")

    for var in SECRET_VARS:
        value = env_values.get(var)
        if value is None:
            continue
        if value in KNOWN_BAD_SECRETS:
            failures.append(f".env has {var} set to a known-bad value; rotate")

    unrotated = [
        var
        for var in SECRET_VARS
        if var in env_values
        and var in example_values
        and env_values[var] == example_values[var]
    ]
    if unrotated:
        msg = ", ".join(unrotated)
        if prod:
            failures.append(
                f".env still uses .env.example values for: {msg}; rotate before production"
            )
        else:
            warnings.append(
                f".env still uses .env.example values for: {msg} "
                "(fine for demo; rotate before going to production — see doctor --prod)"
            )

    return failures, warnings


def _run_doctor(prod: bool) -> None:
    root = repo_root()
    contextualization = root / "docs" / "contextualization.md"
    docs_text = contextualization.read_text(encoding="utf-8") if contextualization.exists() else ""
    failures: list[str] = []
    warnings: list[str] = []

    for surface in surfaces():
        surface_id = surface["id"]
        target = root / surface["path"]
        if not target.exists():
            failures.append(f"{surface_id}: missing {surface['path']}")
        if surface_id not in docs_text:
            failures.append(f"{surface_id}: missing docs reference")

    failures.extend(_check_env_safety(root))

    secret_failures, secret_warnings = _check_known_bad_secrets(root, prod)
    failures.extend(secret_failures)
    warnings.extend(secret_warnings)

    for warning in warnings:
        typer.echo(f"WARN: {warning}")

    if failures:
        for failure in failures:
            typer.echo(f"FAIL: {failure}")
        raise typer.Exit(code=1)

    typer.echo("OK: config surfaces, docs, and files are consistent.")


@app.command()
def doctor(
    prod: bool = typer.Option(
        False,
        "--prod",
        help="Pre-production gate: also fail if secrets in .env still match .env.example.",
    ),
) -> None:
    """Check manifest, docs, and file consistency."""
    _run_doctor(prod=prod)


@app.command()
def apply(
    profile: str = typer.Option("demo", help="Context profile to apply."),
    dry_run: bool = typer.Option(False, help="Print intended changes without writing."),
    check: bool = typer.Option(False, help="Validate only; do not prompt or write."),
    non_interactive: bool = typer.Option(False, help="Use profile values without prompts."),
) -> None:
    """Apply or preview context values."""
    _run_doctor(prod=False)
    values = load_profile(profile)

    if not non_interactive and not check:
        confirmed = questionary.confirm(
            f"Apply profile '{profile}' to {values.get('project_name', 'this distro')}?",
            default=False,
        ).ask()
        if not confirmed:
            raise typer.Exit(code=1)

    typer.echo("Planned context values:")
    for key in (
        "context_slug",
        "context_name",
        "project_name",
        "timezone",
        "default_nationality",
        "facility_id",
        "public_hostname",
    ):
        typer.echo(f"  {key}: {values.get(key)}")

    if check or dry_run:
        typer.echo("No files written.")
        return

    # Production writes will be expanded surface-by-surface with diff previews.
    (repo_root() / ".context.yml").write_text(yaml.safe_dump(values), encoding="utf-8")
    typer.echo("Wrote .context.yml")


if __name__ == "__main__":
    app()
